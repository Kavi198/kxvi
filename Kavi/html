,<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Wedding Anniversary | Yathee & Rayana</title>
    <!-- Three.js Library for 3D Graphics -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- GSAP for Smooth Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <!-- Canvas Confetti for Fireworks -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Great+Vibes&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Montserrat', sans-serif;
            background-color: #0d020d;
            color: #ffffff;
        }

        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none;
        }

        /* Glassmorphism Card Style */
        .glass-card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 215, 0, 0.25);
            border-radius: 24px;
            padding: 40px;
            width: 90%;
            max-width: 520px;
            text-align: center;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(255, 215, 0, 0.1);
            pointer-events: auto;
            transform: translateY(0);
            transition: all 0.5s ease;
        }

        /* Lock Screen Styling */
        .lock-icon {
            font-size: 3rem;
            margin-bottom: 15px;
            display: inline-block;
            background: linear-gradient(135deg, #ffd700, #ff416c);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.5));
        }

        h2.lock-title {
            font-family: 'Cinzel', serif;
            font-size: 1.8rem;
            letter-spacing: 2px;
            color: #fff;
            margin-bottom: 10px;
        }

        p.lock-sub {
            font-size: 0.95rem;
            color: #d1d1d1;
            margin-bottom: 25px;
            font-weight: 300;
        }

        .input-group {
            position: relative;
            margin-bottom: 25px;
        }

        input[type="password"] {
            width: 100%;
            padding: 16px 20px;
            background: rgba(0, 0, 0, 0.4);
            border: 1.5px solid rgba(255, 215, 0, 0.4);
            border-radius: 50px;
            color: #fff;
            font-size: 1.1rem;
            letter-spacing: 4px;
            text-align: center;
            outline: none;
            transition: all 0.3s ease;
        }

        input[type="password"]:focus {
            border-color: #ffd700;
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
            background: rgba(0, 0, 0, 0.6);
        }

        .btn-glow {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: white;
            border: none;
            padding: 16px 36px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 50px;
            cursor: pointer;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            box-shadow: 0 10px 25px rgba(255, 65, 108, 0.4);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-glow:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 15px 35px rgba(255, 65, 108, 0.6);
        }

        .error-message {
            color: #ff4757;
            font-size: 0.85rem;
            margin-top: 12px;
            display: none;
            font-weight: 500;
        }

        /* Celebration Screen Content */
        #celebration-screen {
            display: none;
            opacity: 0;
            max-width: 650px;
        }

        .anniversary-badge {
            font-family: 'Cinzel', serif;
            font-size: 0.9rem;
            letter-spacing: 4px;
            color: #ffd700;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .names-header {
            font-family: 'Great Vibes', cursive;
            font-size: 4.5rem;
            background: linear-gradient(135deg, #fff 30%, #ffd700 70%, #ff416c);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.2;
            margin-bottom: 15px;
            filter: drop-shadow(0 0 15px rgba(255, 215, 0, 0.3));
        }

        .love-quote {
            font-size: 1.05rem;
            line-height: 1.8;
            color: #e2e2e2;
            margin-bottom: 25px;
            font-weight: 300;
            font-style: italic;
        }

        .dedicated-tag {
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 25px;
            text-transform: uppercase;
        }

        .music-control-btn {
            background: rgba(255, 215, 0, 0.15);
            border: 1px solid rgba(255, 215, 0, 0.5);
            color: #ffd700;
            padding: 12px 28px;
            border-radius: 50px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 1px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
        }

        .music-control-btn:hover {
            background: rgba(255, 215, 0, 0.3);
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
        }

        @media (max-width: 600px) {
            .names-header { font-size: 3.2rem; }
            .glass-card { padding: 30px 20px; }
            .love-quote { font-size: 0.95rem; }
        }
    </style>
</head>
<body>

    <!-- 3D WebGL Canvas Container -->
    <div id="canvas-container"></div>

    <!-- Interface Overlay -->
    <div class="overlay">
        
        <!-- STEP 1: PASSWORD LOCK SCREEN -->
        <div id="lock-screen" class="glass-card">
            <div class="lock-icon">🔒</div>
            <h2 class="lock-title">Exclusive Entry</h2>
            <p class="lock-sub">Enter Yathee & Rayana's Special Wedding Date to Unlock</p>
            
            <div class="input-group">
                <input type="password" id="password-input" placeholder="DDMMYYYY" maxlength="8">
            </div>
            
            <button class="btn-glow" onclick="verifyPassword()">Unlock Surprise ❤️</button>
            <div id="error-msg" class="error-message">Incorrect Wedding Date! Please try again.</div>
        </div>

        <!-- STEP 2: CELEBRATION & DEDICATION SCREEN -->
        <div id="celebration-screen" class="glass-card">
            <div class="anniversary-badge">Happy Wedding Anniversary</div>
            <h1 class="names-header">Yathee & Rayana</h1>
            
            <p class="love-quote">
                "No matter how many miles separate us today, true love bridges every distance. 
                Even across oceans and continents, your heart is always right here where it belongs. 
                Wishing both of you a lifetime of endless laughter, deep connection, and everlasting joy!"
            </p>

            <div class="dedicated-tag">✨ Dedicated with love from home ✨</div>

            <button class="music-control-btn" id="music-btn" onclick="toggleAudio()">
                <span id="music-icon">🎵</span> <span id="music-text">Playing Background Music</span>
            </button>
        </div>

    </div>

    <!-- Background Music Audio -->
    <audio id="bg-music" loop preload="auto">
        <source src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=romantic-wedding-cinematic-piano-112199.mp3" type="audio/mpeg">
    </audio>

    <script>
        /* ==========================================================
           1. PASSWORD SECURITY & UNLOCK LOGIC
           ========================================================== */
        // SET YOUR WEDDING DATE PASSWORD HERE (Format: DDMMYYYY)
        const CORRECT_PASSWORD = "12052020"; // CHANGE THIS to Yathee & Rayana's real wedding date!

        function verifyPassword() {
            const inputVal = document.getElementById("password-input").value.trim();
            const errorMsg = document.getElementById("error-msg");

            if (inputVal === CORRECT_PASSWORD) {
                gsap.to("#lock-screen", {
                    duration: 0.8,
                    scale: 0.8,
                    opacity: 0,
                    ease: "back.in(1.7)",
                    onComplete: () => {
                        document.getElementById("lock-screen").style.display = "none";
                        showCelebration();
                    }
                });
            } else {
                errorMsg.style.display = "block";
                gsap.fromTo("#lock-screen", { x: -10 }, { x: 10, duration: 0.1, repeat: 5, yoyo: true });
            }
        }

        document.getElementById("password-input").addEventListener("keypress", function(event) {
            if (event.key === "Enter") {
                verifyPassword();
            }
        });

        function showCelebration() {
            const celScreen = document.getElementById("celebration-screen");
            celScreen.style.display = "block";
            
            gsap.to(celScreen, {
                duration: 1.2,
                opacity: 1,
                y: 0,
                scale: 1,
                ease: "power3.out"
            });

            triggerConfetti();

            gsap.to(heartMesh.rotation, { y: heartMesh.rotation.y + Math.PI * 4, duration: 3, ease: "power2.out" });
            gsap.to(heartMesh.scale, { x: 1.3, y: 1.3, z: 1.3, duration: 1.5, yoyo: true, repeat: 1 });

            playMusic();
        }

        /* ==========================================================
           2. AUDIO CONTROL SYSTEM
           ========================================================== */
        const audio = document.getElementById("bg-music");
        const musicBtn = document.getElementById("music-btn");
        const musicIcon = document.getElementById("music-icon");
        const musicText = document.getElementById("music-text");

        function playMusic() {
            audio.play().then(() => {
                musicIcon.innerText = "⏸️";
                musicText.innerText = "Pause Music";
            }).catch(() => {
                musicIcon.innerText = "🎵";
                musicText.innerText = "Play Romantic Music";
            });
        }

        function toggleAudio() {
            if (audio.paused) {
                audio.play();
                musicIcon.innerText = "⏸️";
                musicText.innerText = "Pause Music";
            } else {
                audio.pause();
                musicIcon.innerText = "🎵";
                musicText.innerText = "Play Romantic Music";
            }
        }

        /* ==========================================================
           3. FIREWORKS & CONFETTI EFFECT
           ========================================================== */
        function triggerConfetti() {
            const duration = 4 * 1000;
            const animationEnd = Date.now() + duration;
            const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 1000 };

            function randomInRange(min, max) {
                return Math.random() * (max - min) + min;
            }

            const interval = setInterval(function() {
                const timeLeft = animationEnd - Date.now();

                if (timeLeft <= 0) {
                    return clearInterval(interval);
                }

                const particleCount = 50 * (timeLeft / duration);
                confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 }, colors: ['#ffd700', '#ff416c', '#ffffff'] }));
                confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 }, colors: ['#ffd700', '#ff416c', '#ffffff'] }));
            }, 250);
        }

        /* ==========================================================
           4. THREE.JS 3D SCENE GENERATION
           ========================================================== */
        let scene, camera, renderer, heartMesh, particlesMesh;

        function init3D() {
            const container = document.getElementById('canvas-container');

            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x0d020d, 0.015);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.z = 22;

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const pointLight1 = new THREE.PointLight(0xffd700, 2, 50);
            pointLight1.position.set(10, 15, 10);
            scene.add(pointLight1);

            const pointLight2 = new THREE.PointLight(0xff416c, 2.5, 50);
            pointLight2.position.set(-10, -10, 10);
            scene.add(pointLight2);

            const heartShape = new THREE.Shape();
            const x = 0, y = 0;
            heartShape.moveTo(x + 0.5, y + 0.5);
            heartShape.bezierCurveTo(x + 0.5, y + 0.5, x + 0.4, y, x, y);
            heartShape.bezierCurveTo(x - 0.6, y, x - 0.6, y + 0.7, x - 0.6, y + 0.7);
            heartShape.bezierCurveTo(x - 0.6, y + 1.1, x - 0.3, y + 1.54, x + 0.5, y + 1.9);
            heartShape.bezierCurveTo(x + 1.3, y + 1.54, x + 1.6, y + 1.1, x + 1.6, y + 0.7);
            heartShape.bezierCurveTo(x + 1.6, y + 0.7, x + 1.6, y, x + 1.0, y);
            heartShape.bezierCurveTo(x + 0.7, y, x + 0.5, y + 0.5, x + 0.5, y + 0.5);

            const extrudeSettings = {
                depth: 0.4,
                bevelEnabled: true,
                bevelSegments: 5,
                steps: 2,
                bevelSize: 0.2,
                bevelThickness: 0.2
            };

            const heartGeometry = new THREE.ExtrudeGeometry(heartShape, extrudeSettings);
            heartGeometry.center();

            const heartMaterial = new THREE.MeshStandardMaterial({
                color: 0xff1e56,
                metalness: 0.7,
                roughness: 0.2,
                emissive: 0x3a0010,
                wireframe: false
            });

            heartMesh = new THREE.Mesh(heartGeometry, heartMaterial);
            heartMesh.scale.set(4.5, 4.5, 4.5);
            heartMesh.rotation.x = Math.PI;
            scene.add(heartMesh);

            const particlesCount = 800;
            const positions = new Float32Array(particlesCount * 3);

            for (let i = 0; i < particlesCount * 3; i += 3) {
                positions[i] = (Math.random() - 0.5) * 60;
                positions[i + 1] = (Math.random() - 0.5) * 60;
                positions[i + 2] = (Math.random() - 0.5) * 60;
            }

            const particlesGeometry = new THREE.BufferGeometry();
            particlesGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

            const particlesMaterial = new THREE.PointsMaterial({
                color: 0xffd700,
                size: 0.25,
                transparent: true,
                opacity: 0.8,
                blending: THREE.AdditiveBlending
            });

            particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
            scene.add(particlesMesh);

            let clock = new THREE.Clock();

            function animate() {
                requestAnimationFrame(animate);
                const elapsedTime = clock.getElapsedTime();

                heartMesh.rotation.y = elapsedTime * 0.5;
                heartMesh.position.y = Math.sin(elapsedTime * 1.5) * 0.5;

                particlesMesh.rotation.y = elapsedTime * 0.05;
                particlesMesh.rotation.x = elapsedTime * 0.02;

                renderer.render(scene, camera);
            }

            animate();
        }

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        window.onload = init3D;
    </script>
</body>
</html>